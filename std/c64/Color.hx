package c64;

/** The 16 C64 colors. **/
class Color {
	public static inline final BLACK = 0;
	public static inline final WHITE = 1;
	public static inline final RED = 2;
	public static inline final CYAN = 3;
	public static inline final PURPLE = 4;
	public static inline final GREEN = 5;
	public static inline final BLUE = 6;
	public static inline final YELLOW = 7;
	public static inline final ORANGE = 8;
	public static inline final BROWN = 9;
	public static inline final LIGHT_RED = 10;
	public static inline final DARK_GREY = 11;
	public static inline final GREY = 12;
	public static inline final LIGHT_GREEN = 13;
	public static inline final LIGHT_BLUE = 14;
	public static inline final LIGHT_GREY = 15;
}
