#!/usr/bin/env bash
# haxe64 - compile a Haxe program to a Commodore 64 .prg
#
#   haxe64 [options] [-cp dir ...] -main Main [-o out.prg]
#     --sim        build for the llvm-mos 6502 simulator instead (for tests) and run it
#     --run        start the .prg in VICE after building
#     --keep-c     keep the generated C file next to the output
#     -D name      pass a define to Haxe
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LLVM_MOS="${LLVM_MOS:-$HOME/.local/opt/llvm-mos}"
VICE="${VICE:-x64sc}"

MAIN=""; OUT=""; SIM=0; RUN=0; CPS=(); DEFS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -main) MAIN="$2"; shift 2;;
    -cp) CPS+=(-cp "$2"); shift 2;;
    -D) DEFS+=(-D "$2"); shift 2;;
    -lib|--library) DEFS+=(-lib "$2"); shift 2;;
    -o) OUT="$2"; shift 2;;
    --sim) SIM=1; shift;;
    --run) RUN=1; shift;;
    --keep-c) shift;;
    -h|--help) sed -n '2,9p' "$0"; exit 0;;
    *) echo "haxe64: unknown argument $1" >&2; exit 1;;
  esac
done
[[ -z "$MAIN" ]] && { echo "haxe64: -main is required" >&2; exit 1; }
[[ ${#CPS[@]} -eq 0 ]] && CPS=(-cp .)
[[ -z "$OUT" ]] && OUT="build/${MAIN##*.}.prg"
mkdir -p "$(dirname "$OUT")"
CFILE="${OUT%.*}.c"

# PNG reading for flixel.system.FlxAssets
if haxelib path format >/dev/null 2>&1; then DEFS+=(-lib format); fi

haxe -cp "$ROOT/std" -cp "$ROOT/src" "${CPS[@]}" "${DEFS[@]+"${DEFS[@]}"}" -main "$MAIN" \
  --no-output -dce full -D haxe64 --macro "haxe64.Generator.use()" -D "haxe64-out=$CFILE"

if [[ $SIM -eq 1 ]]; then
  "$LLVM_MOS/bin/mos-sim-clang" -Os -fwrapv -Wno-parentheses-equality -Wno-constant-conversion -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types -I "$ROOT/runtime" -o "$OUT" "$CFILE"
  "$LLVM_MOS/bin/mos-sim" "$OUT"
  exit $?
fi

"$LLVM_MOS/bin/mos-c64-clang" -Os -fwrapv -Wno-parentheses-equality -Wno-constant-conversion -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types -I "$ROOT/runtime" -o "$OUT" "$CFILE"
echo "haxe64: $OUT ($(wc -c < "$OUT" | tr -d ' ') bytes)"
[[ $RUN -eq 1 ]] && exec "$VICE" -autostart "$OUT"
exit 0
