package haxe64;

#if macro
import haxe.macro.Context;
import haxe.macro.Expr.Position;
import haxe.macro.Type;
import haxe.macro.TypedExprTools;

using StringTools;
using Lambda;

/**
	Haxe64 backend: turns the typed Haxe AST into a single C file,
	which llvm-mos then compiles into a C64 .prg.

	Usage (see bin/haxe64):
	  haxe -cp std -cp src -main Main --no-output -dce full
	       --macro haxe64.Generator.use() -D haxe64-out=build/main.c
**/
class Generator {
	public static function use() {
		Context.onGenerate(function(types) {
			var out = Context.definedValue("haxe64-out");
			if (out == null) out = "build/main.c";
			var g = new Generator(types);
			var code = g.run();
			var dir = haxe.io.Path.directory(out);
			if (dir != "" && !sys.FileSystem.exists(dir)) sys.FileSystem.createDirectory(dir);
			sys.io.File.saveContent(out, code);
		});
	}

	static final C_KEYWORDS = [
		"auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum", "extern", "float", "for", "goto", "if",
		"inline", "int", "long", "register", "restrict", "return", "short", "signed", "sizeof", "static", "struct", "switch", "typedef", "union",
		"unsigned", "void", "volatile", "while", "bool", "true", "false", "main", "self", "asm", "NULL"
	];

	// ---- state ----
	var queue:Array<Void->Void> = [];
	var emittedFuncs:Map<String, Bool> = new Map();
	var emittedVars:Map<String, Bool> = new Map();
	var emittedClasses:Map<String, Bool> = new Map();
	var emittedEnums:Map<String, Bool> = new Map();

	var bufTypes = new StringBuf(); // typedefs, enums
	var bufStructs = new StringBuf();
	var bufProtos = new StringBuf();
	var bufGlobals = new StringBuf();
	var bufFuncs = new StringBuf();
	var initCode = new StringBuf();
	var bufFnTypes = new StringBuf();

	// classes / inheritance
	var allClasses:Array<ClassType> = [];
	var classIds:Map<String, Int> = new Map();
	var nextClassId = 1;
	var usedClasses:Array<ClassType> = [];
	var instClasses:Array<ClassType> = [];
	var pools:Map<String, Bool> = new Map();
	var virtualCache:Map<String, Bool> = new Map();
	var virtualUsed:Map<String, {root:ClassType, name:String}> = new Map();
	var isOfUsed:Map<String, ClassType> = new Map();
	var anyPoolUsed = false;
	var fnTypes:Map<String, String> = new Map();
	var fnTypeCount = 0;
	var curClass:ClassType = null;
	var curRet:Type = null;
	var lambdaCount = 0;
	var literalCount = 0;

	// per function
	var localNames:Map<Int, String>;
	var usedNames:Map<String, Bool>;
	var localArrayLen:Map<Int, Int>;
	var tmpCounter = 0;
	var indentLevel = 1;

	public function new(types:Array<Type>) {
		for (t in types) switch t {
			case TInst(c, _): allClasses.push(c.get());
			case _:
		}
	}

	public function run():String {
		var mainExpr = Context.getMainExpr();
		if (mainExpr == null) Context.fatalError("haxe64: no main class (-main) given", Context.currentPos());

		beginFunction();
		var mainCall = genExpr(mainExpr);
		// fixpoint: virtual dispatchers need every override that may be called
		var changed = true;
		while (changed) {
			while (queue.length > 0) queue.shift()();
			changed = false;
			for (k => v in virtualUsed) for (impl in implsFor(v.root, v.name)) {
				var n = className(impl.c) + "_" + sanitize(v.name);
				if (!emittedFuncs.exists(n)) {
					useFunction(impl.c, impl.f, false, impl.f.pos);
					changed = true;
				}
			}
		}
		emitDispatchers();
		while (queue.length > 0) queue.shift()();

		var b = new StringBuf();
		b.add("/* Generated by haxe64 - do not edit */\n");
		b.add("#include \"haxe64.h\"\n\n");
		b.add(bufTypes.toString());
		b.add("\n");
		b.add(bufFnTypes.toString());
		b.add("\n");
		b.add(bufStructs.toString());
		b.add("\n");
		b.add(bufProtos.toString());
		b.add("\n");
		b.add(bufGlobals.toString());
		b.add("\n");
		b.add(bufFuncs.toString());
		b.add("int main(void) {\n\th64_init();\n");
		b.add(initCode.toString());
		b.add('\t$mainCall;\n\treturn 0;\n}\n');
		return b.toString();
	}

	// =====================================================================
	// names & types
	// =====================================================================

	static function err(msg:String, pos:Position):Dynamic {
		Context.fatalError("haxe64: " + msg, pos);
		return null;
	}

	static function sanitize(s:String):String {
		var r = ~/[^A-Za-z0-9_]/g.replace(s, "_");
		if (C_KEYWORDS.contains(r)) r += "_";
		return r;
	}

	static function className(c:ClassType):String {
		var n = c.meta.has(":native") ? metaString(c.meta, ":native") : null;
		if (n != null) return n;
		var parts = c.pack.copy();
		parts.push(c.name);
		var s = parts.map(sanitize).join("_");
		while (s.startsWith("_")) s = s.substr(1);
		return s;
	}

	static function enumName(e:EnumType):String {
		var parts = e.pack.copy();
		parts.push(e.name);
		return parts.map(sanitize).join("_");
	}

	static function metaString(m:MetaAccess, name:String):Null<String> {
		var e = m.extract(name);
		if (e.length == 0 || e[0].params == null || e[0].params.length == 0) return null;
		return switch e[0].params[0].expr {
			case EConst(CString(s, _)): s;
			case EConst(CIdent(s)): s;
			case _: null;
		}
	}

	static function metaInt(m:MetaAccess, name:String):Null<Int> {
		var e = m.extract(name);
		if (e.length == 0 || e[0].params == null || e[0].params.length == 0) return null;
		return switch e[0].params[0].expr {
			case EConst(CInt(s)): Std.parseInt(s);
			case _: null;
		}
	}

	function staticName(c:ClassType, cf:ClassField):String {
		var n = metaString(cf.meta, ":native");
		if (n != null) return n;
		return className(c) + "_" + sanitize(cf.name);
	}

	function isFloat(t:Type):Bool {
		return switch Context.follow(t) {
			case TAbstract(_.get() => {pack: [], name: "Float"}, _): true;
			case _: false;
		}
	}

	function isVoid(t:Type):Bool {
		return switch Context.follow(t) {
			case TAbstract(_.get() => {pack: [], name: "Void"}, _): true;
			case TMono(_): true;
			case _: false;
		}
	}

	/** Integer-like (Int, UInt, U8, ...) but not Float. **/
	function isIntLike(t:Type):Bool {
		if (isFloat(t)) return false;
		return switch Context.followWithAbstracts(t) {
			case TAbstract(_.get() => {pack: [], name: "Int" | "UInt"}, _): true;
			case TAbstract(a, _): a.get().meta.has(":ctype");
			case _: false;
		}
	}

	function isString(t:Type):Bool {
		return switch Context.follow(t) {
			case TInst(_.get() => {pack: [], name: "String"}, _): true;
			case _: false;
		}
	}

	function arrayElem(t:Type):Null<Type> {
		return switch Context.follow(t) {
			case TInst(_.get() => {pack: [], name: "Array"}, [p]): p;
			case _: null;
		}
	}

	/** C type for a Haxe type. */
	function ctype(t:Type, pos:Position):String {
		switch t {
			case TMono(r):
				var inner = r.get();
				return inner == null ? "int16_t" : ctype(inner, pos);
			case TLazy(f):
				return ctype(f(), pos);
			case TType(_.get() => td, params):
				if (td.pack.length == 0 && td.name == "Null") return ctype(params[0], pos);
				return ctype(Context.follow(t, true), pos);
			case TAbstract(_.get() => a, params):
				var ct = metaString(a.meta, ":ctype");
				if (ct != null) return ct;
				if (a.pack.length == 0) switch a.name {
					case "Int": return "int16_t";
					case "UInt": return "uint16_t";
					case "Bool": return "bool";
					case "Void": return "void";
					case "Float": return "int16_t"; // 12.4 fixed point
					case "Null": return ctype(params[0], pos);
					case "Dynamic", "Any": return "void*"; // only as an opaque pointer (e.g. callback parameters)
					case _:
				}
				if (a.meta.has(":coreType")) return err('core type ${a.name} has no @:ctype', pos);
				return ctype(Context.followWithAbstracts(t, true), pos);
			case TInst(_.get() => c, params):
				if (c.pack.length == 0 && c.name == "String") return "const char*";
				if (c.pack.length == 0 && c.name == "Array") return ctype(params[0], pos) + "*";
				if (c.kind.match(KTypeParameter(_))) return err("type parameters are only supported on @:generic classes", pos);
				if (c.isExtern) return err('extern class ${c.name} cannot be used as a value type', pos);
				useClass(c, pos);
				return className(c) + "*";
			case TEnum(_.get() => e, _):
				useEnum(e, pos);
				return "uint8_t";
			case TFun(args, ret):
				var argT = [for (a in args) ctype(a.t, pos)];
				var r = ctype(ret, pos);
				var key = r + "(" + argT.join(",") + ")";
				if (!fnTypes.exists(key)) {
					var n = "h64_fn" + (fnTypeCount++);
					fnTypes.set(key, n);
					bufFnTypes.add('typedef $r (*$n)(${argT.length == 0 ? "void" : argT.join(", ")});\n');
				}
				return fnTypes.get(key);
			case TAnonymous(_):
				return err("anonymous structures are not supported; use a class", pos);
			case TDynamic(_):
				return "void*";
		}
	}

	// =====================================================================
	// enums
	// =====================================================================

	function useEnum(e:EnumType, pos:Position) {
		var n = enumName(e);
		if (emittedEnums.exists(n)) return;
		emittedEnums.set(n, true);
		var ctors = [for (name in e.names) e.constructs.get(name)];
		ctors.sort((a, b) -> a.index - b.index);
		bufTypes.add('/* enum ${e.name} */\n');
		for (c in ctors) {
			switch c.type {
				case TFun(_, _): err('enum ${e.name}.${c.name}: constructors with arguments are not supported', c.pos);
				case _:
			}
			bufTypes.add('#define ${n}_${sanitize(c.name)} ${c.index}\n');
		}
	}

	// =====================================================================
	// classes
	// =====================================================================

	function superOf(c:ClassType):Null<ClassType> {
		return c.superClass == null ? null : c.superClass.t.get();
	}

	function isSubclassOf(c:ClassType, base:ClassType):Bool {
		var x = c;
		var bn = className(base);
		while (x != null) {
			if (className(x) == bn) return true;
			x = superOf(x);
		}
		return false;
	}

	/** Has storage in the struct (not a pure get/set property). **/
	static function physical(f:ClassField):Bool {
		return switch f.kind {
			case FVar(read, write):
				f.meta.has(":isVar") || read.match(AccNormal | AccNo) || write.match(AccNormal | AccNo);
			case _: false;
		}
	}

	function useClass(c:ClassType, pos:Position) {
		var n = className(c);
		if (emittedClasses.exists(n)) return;
		emittedClasses.set(n, true);
		var sup = superOf(c);
		if (sup != null) useClass(sup, pos);
		if (c.interfaces.length > 0) err('class ${c.name}: interfaces are not supported yet', c.pos);
		if (c.params.length > 0) err('class ${c.name}: generic classes need @:generic', c.pos);
		classIds.set(n, nextClassId++);
		usedClasses.push(c);
		bufTypes.add('typedef struct $n $n;\n');

		// struct body generated lazily (field types may reference other classes); parent fields first,
		// so a pointer to a subclass object is also a valid pointer to its parent class
		queue.push(function() {
			var chain = [];
			var x = c;
			while (x != null) {
				chain.unshift(x);
				x = superOf(x);
			}
			var s = new StringBuf();
			s.add('struct $n {\n\tuint8_t _cls;\n');
			for (k in chain) for (f in k.fields.get()) {
				if (!physical(f)) continue;
				var et = arrayElem(f.type);
				var size = metaInt(f.meta, ":size");
				if (et != null && size != null)
					s.add('\t${ctype(et, f.pos)} ${sanitize(f.name)}[$size];\n');
				else
					s.add('\t${ctype(f.type, f.pos)} ${sanitize(f.name)};\n');
			}
			s.add("};\n");
			bufStructs.add(s.toString());
		});
	}

	/** Object pool for a class that is instantiated with `new` (`@:pool(N)`, default 8). **/
	function usePool(c:ClassType, pos:Position) {
		var n = className(c);
		useClass(c, pos);
		if (pools.exists(n)) return;
		pools.set(n, true);
		instClasses.push(c);
		var poolSize = metaInt(c.meta, ":pool");
		if (poolSize == null) poolSize = 8;
		var id = classIds.get(n);
		bufGlobals.add('static $n ${n}_pool[$poolSize];\nstatic uint8_t ${n}_live[$poolSize];\n');
		bufProtos.add('static $n* ${n}_alloc(void);\nstatic void ${n}_free($n* p);\nstatic bool ${n}_alive($n* p);\n');
		bufFuncs.add('static $n* ${n}_alloc(void) {\n\tfor (uint8_t i = 0; i < $poolSize; i++) if (!${n}_live[i]) {\n\t\t${n}_live[i] = 1;\n\t\tmemset(&${n}_pool[i], 0, sizeof($n));\n\t\t${n}_pool[i]._cls = $id;\n\t\treturn &${n}_pool[i];\n\t}\n\th64_panic("POOL FULL: $n");\n\treturn 0;\n}\n\n');
		bufFuncs.add('static void ${n}_free($n* p) { if (p) ${n}_live[p - ${n}_pool] = 0; }\n\n');
		bufFuncs.add('static bool ${n}_alive($n* p) { return p && ${n}_live[p - ${n}_pool]; }\n\n');
	}

	// ---- virtual methods (dispatch by class id: a switch is faster on the 6502 than a function-pointer vtable) ----

	/** The topmost class in the chain that declares `name`. **/
	function rootOf(c:ClassType, name:String):ClassType {
		var root = c;
		var x = superOf(c);
		while (x != null) {
			for (f in x.fields.get()) if (f.name == name) root = x;
			x = superOf(x);
		}
		return root;
	}

	function isVirtual(c:ClassType, name:String):Bool {
		var root = rootOf(c, name);
		var key = className(root) + "." + name;
		if (virtualCache.exists(key)) return virtualCache.get(key);
		var v = false;
		for (k in allClasses) if (className(k) != className(root) && isSubclassOf(k, root)) {
			for (o in k.overrides) if (o.get().name == name) v = true;
		}
		virtualCache.set(key, v);
		return v;
	}

	/** The class (and field) whose body runs when `name` is called on an object of exactly class `c`. **/
	function findImpl(c:ClassType, name:String):Null<{c:ClassType, f:ClassField}> {
		var x = c;
		while (x != null) {
			for (f in x.fields.get()) if (f.name == name && f.kind.match(FMethod(_)) && f.expr() != null) return {c: x, f: f};
			x = superOf(x);
		}
		return null;
	}

	function implsFor(root:ClassType, name:String):Array<{c:ClassType, f:ClassField}> {
		var r = [];
		for (k in usedClasses.copy()) if (isSubclassOf(k, root)) {
			var i = findImpl(k, name);
			if (i != null) r.push(i);
		}
		return r;
	}

	function emitDispatchers() {
		for (key => v in virtualUsed) {
			var root = v.root;
			var rn = className(root);
			var fld = null;
			for (f in root.fields.get()) if (f.name == v.name) fld = f;
			var args = [], ret = null;
			switch Context.follow(fld.type) {
				case TFun(a, r):
					args = a;
					ret = r;
				case _:
			}
			var params = ['$rn* self'];
			var names = [];
			for (i in 0...args.length) {
				params.push(ctype(args[i].t, fld.pos) + ' a$i');
				names.push('a$i');
			}
			var rest = names.length > 0 ? ", " + names.join(", ") : "";
			var rt = ctype(ret, fld.pos);
			var sig = 'static $rt ${rn}_${sanitize(v.name)}_v(${params.join(", ")})';
			bufProtos.add(sig + ";\n");
			var b = new StringBuf();
			b.add(sig + " {\n\tswitch (self->_cls) {\n");
			var rootImpl = findImpl(root, v.name);
			var groups = new Map<String, Array<Int>>();
			for (k in usedClasses) if (isSubclassOf(k, root)) {
				var i = findImpl(k, v.name);
				if (i == null) continue;
				var iname = className(i.c);
				if (rootImpl != null && iname == className(rootImpl.c)) continue;
				if (!groups.exists(iname)) groups.set(iname, []);
				groups.get(iname).push(classIds.get(className(k)));
			}
			for (iname => ids in groups) {
				var call = '${iname}_${sanitize(v.name)}((${iname}*)self$rest)';
				b.add('\t\t' + [for (id in ids) 'case $id:'].join(" ") + (rt == "void" ? ' $call; return;\n' : ' return $call;\n'));
			}
			if (rootImpl != null) {
				var rin = className(rootImpl.c);
				var call = '${rin}_${sanitize(v.name)}((${rin}*)self$rest)';
				b.add('\t\tdefault: ' + (rt == "void" ? '$call; return;\n' : 'return $call;\n'));
			} else {
				b.add('\t\tdefault: h64_panic("ABSTRACT ${v.name}");' + (rt == "void" ? "" : ' return 0;') + "\n");
			}
			b.add("\t}\n}\n\n");
			bufFuncs.add(b.toString());
		}
		// type checks (Std.isOfType)
		for (n => c in isOfUsed) {
			var ids = [for (k in usedClasses) if (isSubclassOf(k, c)) classIds.get(className(k))];
			bufProtos.add('static bool h64_isof_$n(void* p);\n');
			bufFuncs.add('static bool h64_isof_$n(void* p) {\n\tif (!p) return false;\n\tswitch (*(uint8_t*)p) {\n\t\t'
				+ [for (id in ids) 'case $id:'].join(" ") + ' return true;\n\t\tdefault: return false;\n\t}\n}\n\n');
		}
		// Pool.free / Pool.alive on any object
		if (anyPoolUsed) {
			var fr = new StringBuf(), al = new StringBuf();
			for (c in instClasses) {
				var n = className(c);
				var id = classIds.get(n);
				fr.add('\t\tcase $id: ${n}_free((${n}*)p); return;\n');
				al.add('\t\tcase $id: return ${n}_alive((${n}*)p);\n');
			}
			bufProtos.add('static void h64_free_any(void* p);\nstatic bool h64_alive_any(void* p);\n');
			bufFuncs.add('static void h64_free_any(void* p) {\n\tif (!p) return;\n\tswitch (*(uint8_t*)p) {\n$fr\t\tdefault: return;\n\t}\n}\n\n');
			bufFuncs.add('static bool h64_alive_any(void* p) {\n\tif (!p) return false;\n\tswitch (*(uint8_t*)p) {\n$al\t\tdefault: return false;\n\t}\n}\n\n');
		}
	}

	function useStaticVar(c:ClassType, cf:ClassField, pos:Position):String {
		var name = staticName(c, cf);
		if (emittedVars.exists(name)) return name;
		emittedVars.set(name, true);

		var init = cf.expr();
		var et = arrayElem(cf.type);
		if (et != null) {
			var size = metaInt(cf.meta, ":size");
			if (size == null && init != null) switch unwrap(init).expr {
				case TArrayDecl(el): size = el.length;
				case _:
			}
			if (size != null) arrayLens.set(name, size);
		}
		queue.push(function() {
			beginFunction();
			var isFinal = cf.isFinal || cf.kind.match(FVar(_, AccNever | AccCtor));
			if (et != null) {
				var elemT = ctype(et, cf.pos);
				var size = metaInt(cf.meta, ":size");
				var align = metaInt(cf.meta, ":align");
				var attr = align != null ? ' __attribute__((aligned($align)))' : "";
				var addr = metaInt(cf.meta, ":address");
				if (addr != null) {
					// array placed at a fixed memory address
					bufGlobals.add('#define $name ((${isFinal ? "" : "volatile "}$elemT*)$addr)\n');
					if (init != null) err("@:address arrays cannot have an initializer", cf.pos);
					return;
				}
				var elems = init == null ? null : switch unwrap(init).expr {
					case TArrayDecl(el): el;
					case _: err("static arrays must be initialized with an array literal or use @:size(N)", cf.pos);
				}
				if (elems != null) {
					if (elems.length == 0 && size == null) err("empty static array: give it a size with @:size(N)", cf.pos);
					if (size != null && elems.length > size) err('array literal has ${elems.length} elements but @:size is $size', cf.pos);
					var n = size != null ? size : elems.length;
					var vals = elems.map(e -> {
						if (!isConst(e)) err("array literal elements of static arrays must be constants", e.pos);
						genAs(e, et);
					});
					bufGlobals.add('static $elemT $name[$n]$attr = {' + vals.join(", ") + '};\n');
				} else {
					if (size == null) err("static array needs an initializer or @:size(N)", cf.pos);
					bufGlobals.add('static $elemT $name[$size]$attr;\n');
				}
				return;
			}
			var t = ctype(cf.type, cf.pos);
			var addr = metaInt(cf.meta, ":address");
			if (addr != null) {
				bufGlobals.add('#define $name (*(volatile $t*)$addr)\n');
				return;
			}
			if (init == null) {
				bufGlobals.add('static $t $name;\n');
			} else if (isConst(init)) {
				bufGlobals.add('static $t $name = ${genAs(init, cf.type)};\n');
			} else {
				bufGlobals.add('static $t $name;\n');
				initCode.add('\t$name = ${genAs(init, cf.type)};\n');
			}
		});
		return name;
	}

	var arrayLens:Map<String, Int> = new Map();

	function useFunction(c:ClassType, cf:ClassField, isStatic:Bool, pos:Position):String {
		var name = isStatic ? staticName(c, cf) : className(c) + "_" + sanitize(cf.name);
		if (emittedFuncs.exists(name)) return name;
		emittedFuncs.set(name, true);
		if (!isStatic) useClass(c, pos);
		queue.push(() -> genFunction(name, c, cf, isStatic, false));
		return name;
	}

	/** `self->field = <initializer>;` for the instance variables of `c` declared with a value (Haxe runs them first in the constructor). **/
	function genFieldInits(c:ClassType):String {
		var b = new StringBuf();
		for (f in c.fields.get()) {
			if (!physical(f)) continue;
			var init = f.expr();
			if (init == null) continue;
			b.add('\tself->${sanitize(f.name)} = ${genAs(init, f.type)};\n');
		}
		return b.toString();
	}

	/** The class in the chain (starting at `c`) whose constructor runs. **/
	function ctorOwner(c:ClassType):Null<ClassType> {
		var x = c;
		while (x != null) {
			if (x.constructor != null) return x;
			x = superOf(x);
		}
		return null;
	}

	/** `Owner_init(self, args)`: the constructor body, callable from `new` and from a subclass's `super(...)`. **/
	function useInit(owner:ClassType, pos:Position):String {
		var name = className(owner) + "_init";
		if (emittedFuncs.exists(name)) return name;
		emittedFuncs.set(name, true);
		useClass(owner, pos);
		var ctor = owner.constructor.get();
		queue.push(() -> genFunction(name, owner, ctor, false, false));
		return name;
	}

	function useConstructor(c:ClassType, pos:Position):String {
		usePool(c, pos);
		var n = className(c);
		var name = n + "_new";
		if (emittedFuncs.exists(name)) return name;
		emittedFuncs.set(name, true);
		var owner = ctorOwner(c);
		if (owner == null) {
			queue.push(function() {
				beginFunction();
				var chain = [];
				var x = c;
				while (x != null) {
					chain.unshift(x);
					x = superOf(x);
				}
				bufProtos.add('static $n* $name(void);\n');
				bufFuncs.add('static $n* $name(void) {\n\t$n* self = ${n}_alloc();\n' + [for (k in chain) genFieldInits(k)].join("") + '\treturn self;\n}\n\n');
			});
			return name;
		}
		var init = useInit(owner, pos);
		var ctor = owner.constructor.get();
		queue.push(function() {
			var args = switch Context.follow(ctor.type) {
				case TFun(a, _): a;
				case _: [];
			}
			var params = [for (i in 0...args.length) ctype(args[i].t, ctor.pos) + ' a$i'];
			var names = [for (i in 0...args.length) 'a$i'];
			var sig = 'static $n* $name(${params.length == 0 ? "void" : params.join(", ")})';
			bufProtos.add(sig + ";\n");
			bufFuncs.add('$sig {\n\t$n* self = ${n}_alloc();\n\t$init((${className(owner)}*)self${names.length > 0 ? ", " + names.join(", ") : ""});\n\treturn self;\n}\n\n');
		});
		return name;
	}

	function genFunction(name:String, c:ClassType, cf:ClassField, isStatic:Bool, isCtor:Bool) {
		var e = cf.expr();
		if (e == null) err('function ${cf.name} has no body', cf.pos);
		var tf = switch e.expr {
			case TFunction(tf): tf;
			case _: err("expected function", cf.pos);
		}
		beginFunction();
		curClass = c;
		curRet = tf.t;
		var cls = className(c);
		var params = [];
		if (!isStatic && !isCtor) params.push('$cls* self');
		for (a in tf.args) {
			params.push(ctype(a.v.t, cf.pos) + " " + localName(a.v));
		}
		var ret = isCtor ? '$cls*' : ctype(tf.t, cf.pos);
		var attrs = cf.meta.has(":irq") ? "__attribute__((interrupt_norecurse)) " : "";
		if (cf.meta.has(":noinline")) attrs += "__attribute__((noinline)) ";
		var sig = 'static $attrs$ret $name(${params.length == 0 ? "void" : params.join(", ")})';
		bufProtos.add(sig + ";\n");
		indentLevel = 1;
		var body = new StringBuf();
		body.add(sig + " {\n");
		if (isCtor) body.add('\t$cls* self = ${cls}_alloc();\n');
		if (name == cls + "_init") body.add(genFieldInits(c));
		body.add(genBlockContents(tf.expr));
		if (isCtor) body.add("\treturn self;\n");
		body.add("}\n\n");
		bufFuncs.add(body.toString());
	}

	// =====================================================================
	// locals
	// =====================================================================

	function beginFunction() {
		localNames = new Map();
		usedNames = new Map();
		localArrayLen = new Map();
	}

	function localName(v:TVar):String {
		var n = localNames.get(v.id);
		if (n != null) return n;
		var base = sanitize(v.name);
		if (base == "this") base = "self";
		n = base;
		var i = 1;
		while (usedNames.exists(n)) n = base + "_" + (i++);
		usedNames.set(n, true);
		localNames.set(v.id, n);
		return n;
	}

	function tmp():String {
		return "_t" + (tmpCounter++);
	}

	// =====================================================================
	// statements
	// =====================================================================

	function ind():String {
		return [for (_ in 0...indentLevel) "\t"].join("");
	}

	function genBlockContents(e:TypedExpr):String {
		var b = new StringBuf();
		switch e.expr {
			case TBlock(el):
				for (s in el) b.add(genStmt(s));
			case _:
				b.add(genStmt(e));
		}
		return b.toString();
	}

	function genStmt(e:TypedExpr):String {
		var i = ind();
		switch e.expr {
			case TBlock(el):
				if (el.length == 0) return "";
				indentLevel++;
				var s = new StringBuf();
				for (x in el) s.add(genStmt(x));
				indentLevel--;
				return '$i{\n${s.toString()}$i}\n';
			case TVar(v, init):
				var et = arrayElem(v.t);
				if (et != null && init != null) switch unwrap(init).expr {
					case TArrayDecl(el):
						var vals = [for (x in el) genAs(x, et)];
						localArrayLen.set(v.id, el.length);
						// constant literals get static storage (a pointer to them may outlive the function)
						var st = Lambda.foreach(el, x -> isConst(x)) ? "static " : "";
						return '$i$st${ctype(et, e.pos)} ${localName(v)}[${el.length}] = {${vals.join(", ")}};\n';
					case _:
				}
				if (et != null && init != null) {
					var len = knownLength(init);
					if (len != null) localArrayLen.set(v.id, len);
				}
				var t = ctype(v.t, e.pos);
				if (init == null) return '$i$t ${localName(v)};\n';
				var val = genAs(init, v.t);
				return '$i$t ${localName(v)} = $val;\n';
			case TIf(cond, eif, eelse):
				var s = '${i}if (${genCond(cond)}) ${genBody(eif)}';
				if (eelse != null) {
					switch eelse.expr {
						case TIf(_, _, _):
							var inner = genStmt(eelse);
							s += '${i}else ' + inner.ltrim();
						case _:
							s += '${i}else ${genBody(eelse)}';
					}
				}
				return s;
			case TWhile(cond, body, true):
				return '${i}while (${genCond(cond)}) ${genBody(body)}';
			case TWhile(cond, body, false):
				var b = genBody(body).rtrim();
				return '${i}do $b while (${genCond(cond)});\n';
			case TFor(v, it, body):
				switch unwrap(it).expr {
					case TBinop(OpInterval, a, b):
						var n = localName(v);
						var end = tmp();
						return '${i}for (int16_t $n = ${genExpr(a)}, $end = ${genExpr(b)}; $n < $end; $n++) ${genBody(body)}';
					case _:
						var arr = genExpr(it);
						var len = arrayLength(it);
						var idx = tmp();
						indentLevel++;
						var inner = '${ind()}${ctype(v.t, e.pos)} ${localName(v)} = $arr[$idx];\n' + genBlockContents(body);
						indentLevel--;
						return '${i}for (int16_t $idx = 0; $idx < $len; $idx++) {\n$inner$i}\n';
				}
			case TSwitch(subject, cases, edef):
				return genSwitch(subject, cases, edef, null);
			case TReturn(null):
				return '${i}return;\n';
			case TReturn(v):
				return '${i}return ${genAs(v, curRet)};\n';
			case TBreak:
				return '${i}break;\n';
			case TContinue:
				return '${i}continue;\n';
			case TThrow(_):
				return '${i}h64_panic("THROW");\n';
			case TMeta(_, inner), TParenthesis(inner):
				return genStmt(inner);
			case TConst(_), TLocal(_), TTypeExpr(_):
				return ""; // no effect
			case _:
				return '$i${genExpr(e)};\n';
		}
	}

	function genBody(e:TypedExpr):String {
		switch e.expr {
			case TBlock(el):
				var st = genStmt(e).ltrim();
				return st == "" ? "{}\n" : st;
			case _:
				indentLevel++;
				var s = genStmt(e);
				indentLevel--;
				return '{\n$s${ind()}}\n';
		}
	}

	function genCond(e:TypedExpr):String {
		var s = genExpr(unwrapParens(e));
		return s;
	}

	/** switch -> if/else chain (Haxe `break` inside a case must break the enclosing loop). `target` = assign result to this var. */
	function genSwitch(subject:TypedExpr, cases:Array<{values:Array<TypedExpr>, expr:TypedExpr}>, edef:Null<TypedExpr>, target:Null<String>):String {
		var i = ind();
		var s = new StringBuf();
		var subj:String;
		var subjExpr = unwrap(subject);
		switch subjExpr.expr {
			case TLocal(_), TConst(_):
				subj = genExpr(subjExpr);
				s.add("");
			case _:
				subj = tmp();
				s.add('$i${ctype(subject.t, subject.pos)} $subj = ${genExpr(subject)};\n');
		}
		var first = true;
		function caseBody(b:TypedExpr):String {
			if (target == null) return genBody(b);
			return genBody(assignLast(b, target));
		}
		for (c in cases) {
			var conds = [for (v in c.values) '$subj == ${genExpr(v)}'];
			s.add('$i${first ? "" : "else "}if (${conds.join(" || ")}) ${caseBody(c.expr)}');
			first = false;
		}
		if (edef != null) {
			if (first) s.add('$i${caseBody(edef)}'); else s.add('${i}else ${caseBody(edef)}');
		}
		return s.toString();
	}

	/** Rewrites an expression so its final value is assigned to `target`. */
	function assignLast(e:TypedExpr, target:String):TypedExpr {
		return switch e.expr {
			case TBlock(el) if (el.length > 0):
				var copy = el.copy();
				copy[copy.length - 1] = assignLast(copy[copy.length - 1], target);
				{expr: TBlock(copy), t: e.t, pos: e.pos};
			case TMeta(_, inner), TParenthesis(inner): assignLast(inner, target);
			case TReturn(_), TBreak, TContinue, TThrow(_): e;
			case _:
				var lhs:TypedExpr = {expr: TIdent('__assign__$target'), t: e.t, pos: e.pos};
				{expr: TBinop(OpAssign, lhs, e), t: e.t, pos: e.pos};
		}
	}

	// =====================================================================
	// expressions
	// =====================================================================

	static function unwrap(e:TypedExpr):TypedExpr {
		return switch e.expr {
			case TMeta(_, inner), TParenthesis(inner): unwrap(inner);
			case TCast(inner, null) if (inner.expr.match(TArrayDecl(_))): unwrap(inner);
			case _: e;
		}
	}

	static function unwrapParens(e:TypedExpr):TypedExpr {
		return switch e.expr {
			case TParenthesis(inner): unwrapParens(inner);
			case _: e;
		}
	}

	function isConst(e:TypedExpr):Bool {
		return switch e.expr {
			case TConst(TThis | TSuper): false;
			case TConst(_): true;
			case TField(_, FEnum(_, _)): true;
			case TParenthesis(x), TMeta(_, x), TCast(x, null): isConst(x);
			case TUnop(OpNeg | OpNegBits | OpNot, false, x): isConst(x);
			case TBinop(op, a, b) if (!op.match(OpAssign | OpAssignOp(_))): isConst(a) && isConst(b);
			case _: false;
		}
	}

	function genConstExpr(e:TypedExpr):String {
		if (!isConst(e)) err("array literal elements of static arrays must be constants", e.pos);
		return genExpr(e);
	}

	function knownLength(e:TypedExpr):Null<Int> {
		var u = unwrap(e);
		return switch u.expr {
			case TLocal(v): localArrayLen.get(v.id);
			case TField(_, FStatic(c, cf)):
				var cff = cf.get();
				if (cff.meta.has(":c")) null else arrayLens.get(useStaticVar(c.get(), cff, u.pos));
			case TField(_, FInstance(_, _, cf)): metaInt(cf.get().meta, ":size");
			case TArrayDecl(el): el.length;
			case _: null;
		}
	}

	function arrayLength(e:TypedExpr):String {
		var u = unwrap(e);
		switch u.expr {
			case TLocal(v) if (localArrayLen.exists(v.id)):
				return Std.string(localArrayLen.get(v.id));
			case TField(_, FStatic(c, cf)):
				var name = useStaticVar(c.get(), cf.get(), u.pos);
				if (arrayLens.exists(name)) return Std.string(arrayLens.get(name));
			case TField(_, FInstance(c, _, cf)):
				var size = metaInt(cf.get().meta, ":size");
				if (size != null) return Std.string(size);
			case TConst(TString(s)):
				return Std.string(s.length);
			case TArrayDecl(el):
				return Std.string(el.length);
			case _:
		}
		return err("array length is only known for local/static array literals or @:size arrays", e.pos);
	}

	/** Generates `e` for a slot of type `target`: Int -> Float converts to 12.4 fixed point. **/
	function genAs(e:TypedExpr, target:Type):String {
		if (target != null && isFloat(target) && isIntLike(e.t)) return toFix(e);
		return genExpr(e);
	}

	function toFix(e:TypedExpr):String {
		if (isFloat(e.t)) return genExpr(e);
		switch unwrap(e).expr {
			case TConst(TInt(i)): return Std.string(i * 16);
			case TUnop(OpNeg, false, {expr: TConst(TInt(i))}): return Std.string(-i * 16);
			case _: return '((int16_t)((${genExpr(e)}) << 4))';
		}
	}

	/** Default values of a function's parameters (missing arguments are filled in at the call site). **/
	static function defaultsOf(cf:Null<ClassField>):Array<Null<TypedExpr>> {
		if (cf == null) return [];
		var e = cf.expr();
		if (e == null) return [];
		return switch e.expr {
			case TFunction(tf): [for (a in tf.args) a.value];
			case _: [];
		}
	}

	function genArgs(args:Array<TypedExpr>, fnType:Type, ?field:ClassField):Array<String> {
		var types = switch Context.follow(fnType) {
			case TFun(a, _): [for (x in a) x.t];
			case _: [];
		}
		var out = [for (i in 0...args.length) genAs(args[i], i < types.length ? types[i] : null)];
		if (args.length < types.length) {
			var defs = defaultsOf(field);
			for (i in args.length...types.length) out.push(i < defs.length && defs[i] != null ? genAs(defs[i], types[i]) : "0");
		}
		return out;
	}

	function genExpr(e:TypedExpr):String {
		switch e.expr {
			case TConst(c):
				return genConst(c, e);
			case TLocal(v):
				return localName(v);
			case TIdent(s):
				if (s.startsWith("__assign__")) return s.substr(10);
				return err('unknown identifier $s', e.pos);
			case TArray(a, idx):
				return '${genExpr(a)}[${genExpr(idx)}]';
			case TBinop(op, a, b):
				return genBinop(op, a, b, e);
			case TField(obj, fa):
				return genField(obj, fa, e);
			case TTypeExpr(_):
				return err("types cannot be used as values", e.pos);
			case TParenthesis(inner):
				return '(${genExpr(inner)})';
			case TObjectDecl(_):
				return err("anonymous objects are not supported; use a class", e.pos);
			case TArrayDecl(el):
				var et = arrayElem(e.t);
				if (et == null || !Lambda.foreach(el, x -> isConst(x))) return err("array literals outside variable initializers must be constant", e.pos);
				var n = "h64_lit" + (literalCount++);
				bufGlobals.add('static ${ctype(et, e.pos)} $n[${el.length}] = {${[for (x in el) genAs(x, et)].join(", ")}};\n');
				return n;
			case TCall(f, args):
				return genCall(f, args, e);
			case TNew(c, _, args):
				var cc = c.get();
				if (cc.isExtern) return err('cannot instantiate extern class ${cc.name}', e.pos);
				var name = useConstructor(cc, e.pos);
				var owner = ctorOwner(cc);
				var a = owner == null ? args.map(genExpr) : genArgs(args, owner.constructor.get().type, owner.constructor.get());
				return '$name(${a.join(", ")})';
			case TUnop(op, postFix, x):
				var s = genExpr(x);
				if (isFloat(x.t) && op.match(OpIncrement | OpDecrement)) return op == OpIncrement ? '($s += 16)' : '($s -= 16)';
				var o = switch op {
					case OpIncrement: "++";
					case OpDecrement: "--";
					case OpNot: "!";
					case OpNeg: "-";
					case OpNegBits: "~";
					case OpSpread: err("spread is not supported", e.pos);
				}
				return postFix ? '$s$o' : '($o$s)';
			case TFunction(tf):
				return genLambda(tf, e);
			case TVar(_, _):
				return err("unexpected variable declaration in expression", e.pos);
			case TBlock(el):
				if (el.length == 0) return "((void)0)";
				var s = new StringBuf();
				s.add("({\n");
				indentLevel++;
				var valued = !isVoid(e.t);
				for (k in 0...el.length) {
					if (valued && k == el.length - 1) s.add(ind() + genExpr(el[k]) + ";\n");
					else s.add(genStmt(el[k]));
				}
				indentLevel--;
				s.add(ind() + "})");
				return s.toString();
			case TFor(_, _, _), TWhile(_, _, _), TReturn(_), TBreak, TContinue, TThrow(_):
				indentLevel++;
				var st = genStmt(e);
				indentLevel--;
				return '({\n$st${ind()}})';
			case TIf(cond, eif, eelse):
				if (eelse == null) {
					indentLevel++;
					var st = genStmt(e);
					indentLevel--;
					return '({\n$st${ind()}})';
				}
				var t = ctype(e.t, e.pos);
				if (t == "void") {
					indentLevel++;
					var st = genStmt(e);
					indentLevel--;
					return '({\n$st${ind()}})';
				}
				return '(${genExpr(cond)} ? ${genAs(eif, e.t)} : ${genAs(eelse, e.t)})';
			case TSwitch(subject, cases, edef):
				var t = ctype(e.t, e.pos);
				indentLevel++;
				if (t == "void") {
					var st = genSwitch(subject, cases, edef, null);
					indentLevel--;
					return '({\n$st${ind()}})';
				}
				var r = tmp();
				var st = '${ind()}$t $r;\n' + genSwitch(subject, cases, edef, r) + '${ind()}$r;\n';
				indentLevel--;
				return '({\n$st${ind()}})';
			case TTry(_, _):
				return err("try/catch is not supported", e.pos);
			case TCast(x, null):
				if (isFloat(e.t) && isIntLike(x.t)) return toFix(x);
				var to = ctype(e.t, e.pos);
				var from = ctype(x.t, x.pos);
				if (to == from) return genExpr(x);
				return '(($to)(${genExpr(x)}))';
			case TCast(x, _):
				// checked cast to a class: unchecked pointer cast on the C64
				return '((${ctype(e.t, e.pos)})(${genExpr(x)}))';
			case TMeta(_, inner):
				return genExpr(inner);
			case TEnumParameter(_, _, _):
				return err("enum parameters are not supported", e.pos);
			case TEnumIndex(x):
				return genExpr(x);
		}
	}

	/** A local function that captures nothing becomes a static C function (closures over locals / this are not supported). **/
	function genLambda(tf:TFunc, e:TypedExpr):String {
		var own = new Map<Int, Bool>();
		for (a in tf.args) own.set(a.v.id, true);
		function scan(x:TypedExpr) {
			switch x.expr {
				case TVar(v, _): own.set(v.id, true);
				case TFor(v, _, _): own.set(v.id, true);
				case TTry(_, catches): for (c in catches) own.set(c.v.id, true);
				case TFunction(inner): for (a in inner.args) own.set(a.v.id, true);
				case _:
			}
			switch x.expr {
				case TLocal(v) if (!own.exists(v.id)):
					err('lambda captures local variable "${v.name}" - closures are not supported on the C64 (pass it as an argument or use a static var)', x.pos);
				case TConst(TThis | TSuper):
					err("lambda uses `this` - closures are not supported on the C64 (use a static function)", x.pos);
				case _:
			}
			TypedExprTools.iter(x, scan);
		}
		scan(tf.expr);
		// generate with a fresh local context, then restore the enclosing function's
		var saved = {ln: localNames, un: usedNames, la: localArrayLen, cr: curRet, il: indentLevel};
		beginFunction();
		curRet = tf.t;
		indentLevel = 1;
		var name = "h64_lambda" + (lambdaCount++);
		var params = [for (a in tf.args) ctype(a.v.t, e.pos) + " " + localName(a.v)];
		var sig = 'static ${ctype(tf.t, e.pos)} $name(${params.length == 0 ? "void" : params.join(", ")})';
		bufProtos.add(sig + ";\n");
		var body = genBlockContents(tf.expr);
		bufFuncs.add('$sig {\n$body}\n\n');
		localNames = saved.ln;
		usedNames = saved.un;
		localArrayLen = saved.la;
		curRet = saved.cr;
		indentLevel = saved.il;
		return name;
	}

	/** Any value as a (temporary) C string, for concatenation / Std.string. **/
	function toStr(e:TypedExpr):String {
		if (isString(e.t)) return genExpr(e);
		if (isFloat(e.t)) return 'h64_ftoa(${genExpr(e)})';
		switch Context.follow(e.t) {
			case TAbstract(_.get() => {name: "Bool", pack: []}, _): return '(${genExpr(e)} ? "true" : "false")';
			case _:
		}
		if (isIntLike(e.t)) return 'h64_itoa(${genExpr(e)})';
		return err("only String, Int, Float and Bool can be converted to String", e.pos);
	}

	function genConst(c:TConstant, e:TypedExpr):String {
		return switch c {
			case TInt(i):
				if (i < -32768 || i > 65535) Context.warning('haxe64: integer $i does not fit into 16 bits', e.pos);
				Std.string(i);
			case TFloat(f):
				var v = Math.round(Std.parseFloat(f) * 16);
				if (v < -32768 || v > 32767) Context.warning('haxe64: $f does not fit into 12.4 fixed point (-2048..2047)', e.pos);
				Std.string(v);
			case TString(s): cString(s);
			case TBool(b): b ? "true" : "false";
			case TNull: "0";
			case TThis: "self";
			case TSuper: "self";
		}
	}

	static function cString(s:String):String {
		var b = new StringBuf();
		b.add('"');
		for (i in 0...s.length) {
			var c = s.charCodeAt(i);
			switch c {
				case '"'.code: b.add('\\"');
				case '\\'.code: b.add("\\\\");
				case '\n'.code: b.add("\\n");
				case '\r'.code: b.add("\\r");
				case '\t'.code: b.add("\\t");
				case _ if (c < 32 || c > 126): b.add('\\x' + StringTools.hex(c, 2) + '""');
				case _: b.addChar(c);
			}
		}
		b.add('"');
		return b.toString();
	}

	function binopStr(op:haxe.macro.Expr.Binop, pos:Position):String {
		return switch op {
			case OpAdd: "+";
			case OpMult: "*";
			case OpDiv: "/";
			case OpSub: "-";
			case OpAssign: "=";
			case OpEq: "==";
			case OpNotEq: "!=";
			case OpGt: ">";
			case OpGte: ">=";
			case OpLt: "<";
			case OpLte: "<=";
			case OpAnd: "&";
			case OpOr: "|";
			case OpXor: "^";
			case OpBoolAnd: "&&";
			case OpBoolOr: "||";
			case OpShl: "<<";
			case OpShr: ">>";
			case OpMod: "%";
			case _: err('operator $op is not supported', pos);
		}
	}

	function genBinop(op:haxe.macro.Expr.Binop, a:TypedExpr, b:TypedExpr, e:TypedExpr):String {
		if (op.match(OpAdd) && (isString(a.t) || isString(b.t)))
			return 'h64_cat(${toStr(a)}, ${toStr(b)})';
		if (op.match(OpAssignOp(OpAdd)) && isString(a.t)) {
			var l = genExpr(a);
			return '$l = h64_cat($l, ${toStr(b)})';
		}
		var fa = isFloat(a.t), fb = isFloat(b.t);
		switch op {
			case OpAssign:
				var lhs = unwrap(a);
				// target placeholder from assignLast
				return '${genExpr(lhs)} = ${genAs(b, a.t)}';
			case OpAssignOp(OpMult) if (fa):
				var l = genExpr(a);
				return fb ? '$l = h64_fmul($l, ${genExpr(b)})' : '$l *= ${genExpr(b)}';
			case OpAssignOp(OpDiv) if (fa):
				var l = genExpr(a);
				return fb ? '$l = h64_fdiv($l, ${genExpr(b)})' : '$l /= ${genExpr(b)}';
			case OpAssignOp(inner) if (fa && inner.match(OpAdd | OpSub | OpMod)):
				return '${genExpr(a)} ${binopStr(inner, e.pos)}= ${toFix(b)}';
			case OpMult if (fa || fb):
				if (fa && fb) return 'h64_fmul(${genExpr(a)}, ${genExpr(b)})';
				return '(${genExpr(a)} * ${genExpr(b)})'; // fixed * int stays fixed
			case OpDiv:
				if (fa && fb) return 'h64_fdiv(${genExpr(a)}, ${genExpr(b)})';
				if (fa) return '(${genExpr(a)} / ${genExpr(b)})';
				if (fb) return 'h64_fdiv(${toFix(a)}, ${genExpr(b)})';
				return 'h64_idiv_fix(${genExpr(a)}, ${genExpr(b)})'; // Int / Int -> Float
			case OpAdd | OpSub | OpMod | OpEq | OpNotEq | OpGt | OpGte | OpLt | OpLte if (fa || fb):
				return '(${toFix(a)} ${binopStr(op, e.pos)} ${toFix(b)})';
			case OpAssignOp(OpUShr):
				var l = genExpr(a);
				return '$l = (uint16_t)($l) >> ${genExpr(b)}';
			case OpAssignOp(inner):
				return '${genExpr(a)} ${binopStr(inner, e.pos)}= ${genExpr(b)}';
			case OpUShr:
				return '((uint16_t)(${genExpr(a)}) >> ${genExpr(b)})';
			case OpEq, OpNotEq if (isString(a.t) && isString(b.t)):
				var r = 'strcmp(${genExpr(a)}, ${genExpr(b)})';
				return op == OpEq ? '($r == 0)' : '($r != 0)';
			case OpNullCoal, OpInterval, OpArrow, OpIn:
				return err('operator $op is not supported', e.pos);
			case _:
				return '(${genExpr(a)} ${binopStr(op, e.pos)} ${genExpr(b)})';
		}
	}

	function genField(obj:TypedExpr, fa:FieldAccess, e:TypedExpr):String {
		switch fa {
			case FStatic(c, cf):
				var cc = c.get(), f = cf.get();
				var tmpl = metaString(f.meta, ":c");
				if (tmpl != null) return applyTemplate(tmpl, [], null, e.pos);
				switch f.kind {
					case FMethod(_):
						if (cc.isExtern) return metaString(f.meta, ":native") ?? err("extern function reference needs @:native", e.pos);
						return useFunction(cc, f, true, e.pos); // function pointer
					case FVar(_, _):
						if (cc.isExtern) {
							var n = metaString(f.meta, ":native");
							if (n == null) err('extern field ${cc.name}.${f.name} needs @:c or @:native', e.pos);
							return n;
						}
						return useStaticVar(cc, f, e.pos);
				}
			case FInstance(c, _, cf):
				var cc = c.get(), f = cf.get();
				if (cc.pack.length == 0 && cc.name == "Array" && f.name == "length") return arrayLength(obj);
				if (cc.pack.length == 0 && cc.name == "String" && f.name == "length") {
					switch unwrap(obj).expr {
						case TConst(TString(s)): return Std.string(s.length);
						case _: return '((int16_t)strlen(${genExpr(obj)}))';
					}
				}
				if (cc.isExtern) return err('field ${cc.name}.${f.name} is not supported', e.pos);
				switch f.kind {
					case FMethod(_): return err("method references (closures) are not supported", e.pos);
					case FVar(_, _):
				}
				useClass(cc, e.pos);
				var o = unwrap(obj).expr.match(TConst(TSuper)) ? "self" : genExpr(obj);
				return '$o->${sanitize(f.name)}';
			case FEnum(en, ef):
				var enT = en.get();
				useEnum(enT, e.pos);
				return '${enumName(enT)}_${sanitize(ef.name)}';
			case FAnon(_), FDynamic(_):
				return err("anonymous/dynamic field access is not supported", e.pos);
			case FClosure(_, _):
				return err("method closures are not supported", e.pos);
		}
	}

	function applyTemplate(tmpl:String, args:Array<TypedExpr>, self:Null<TypedExpr>, pos:Position):String {
		var r = ~/\{(\d+|this)\}/g;
		return r.map(tmpl, function(re) {
			var k = re.matched(1);
			if (k == "this") return self == null ? err("{this} in static template", pos) : genExpr(self);
			var idx = Std.parseInt(k);
			if (idx >= args.length) return err('template argument {$idx} missing', pos);
			return genExpr(args[idx]);
		});
	}

	function genCall(f:TypedExpr, args:Array<TypedExpr>, e:TypedExpr):String {
		switch unwrap(f).expr {
			case TIdent("__c__"), TLocal({name: "__c__"}):
				var code = switch unwrap(args[0]).expr {
					case TConst(TString(s)): s;
					case _: err("__c__ needs a constant string", e.pos);
				}
				return applyTemplate(code, args.slice(1), null, e.pos);
			case TField(_, FStatic(c, cf)):
				var cc = c.get(), fld = cf.get();
				var tmpl = metaString(fld.meta, ":c");
				if (tmpl != null) return applyTemplate(tmpl, args, null, e.pos);
				var full = cc.pack.concat([cc.name]).join(".");
				switch [full, fld.name] {
					case ["haxe.Log", "trace"]:
						return genTrace(args[0]);
					case ["Std", "int"]:
						var a = unwrap(args[0]);
						switch a.expr {
							case TBinop(OpDiv, x, y) if (!isFloat(x.t) && !isFloat(y.t)):
								return '((int16_t)(${genExpr(x)} / ${genExpr(y)}))';
							case _ if (!isFloat(a.t)):
								return genExpr(a);
							case _:
								return 'h64_ftoi(${genExpr(a)})';
						}
					case ["Std", "isOfType"]:
						switch unwrap(args[1]).expr {
							case TTypeExpr(TClassDecl(tc)):
								var tcc = tc.get();
								useClass(tcc, e.pos);
								isOfUsed.set(className(tcc), tcc);
								return 'h64_isof_${className(tcc)}(${genExpr(args[0])})';
							case _:
								return err("Std.isOfType needs a class name", e.pos);
						}
					case ["Math", "abs"]: return 'h64_fabs(${toFix(args[0])})';
					case ["Math", "min"]: return 'h64_fmin(${toFix(args[0])}, ${toFix(args[1])})';
					case ["Math", "max"]: return 'h64_fmax(${toFix(args[0])}, ${toFix(args[1])})';
					case ["Math", "floor"]: return 'h64_ffloor(${toFix(args[0])})';
					case ["Math", "ceil"]: return 'h64_fceil(${toFix(args[0])})';
					case ["Math", "round"]: return 'h64_fround(${toFix(args[0])})';
					case ["Math", "sqrt"]: return 'h64_fsqrt(${toFix(args[0])})';
					case ["Math", "sin"]: return 'h64_fsin(${toFix(args[0])})';
					case ["Math", "cos"]: return 'h64_fcos(${toFix(args[0])})';
					case ["Std", "string"]:
						return toStr(args[0]);
					case ["Std", "random"]:
						return 'h64_random(${genExpr(args[0])})';
					case ["haxe64.Pool", "free"]:
						poolClass(args[0]);
						anyPoolUsed = true;
						return 'h64_free_any(${genExpr(args[0])})';
					case ["haxe64.Pool", "alive"]:
						poolClass(args[0]);
						anyPoolUsed = true;
						return 'h64_alive_any(${genExpr(args[0])})';
					case _:
				}
				if (cc.isExtern) {
					var n = metaString(fld.meta, ":native");
					if (n == null) return err('$full.${fld.name} is not available on the C64', e.pos);
					return '$n(${args.map(genExpr).join(", ")})';
				}
				var name = useFunction(cc, fld, true, e.pos);
				return '$name(${genArgs(args, fld.type, fld).join(", ")})';
			case TField(obj, FInstance(c, _, cf)):
				var cc = c.get(), fld = cf.get();
				var tmpl = metaString(fld.meta, ":c");
				if (tmpl != null) return applyTemplate(tmpl, args, obj, e.pos);
				if (cc.pack.length == 0 && cc.name == "String") {
					switch fld.name {
						case "charCodeAt": return '((uint8_t)(${genExpr(obj)})[${genExpr(args[0])}])';
						case _:
					}
				}
				if (cc.isExtern) return err('${cc.name}.${fld.name}() is not supported on the C64', e.pos);
				var isSuper = unwrap(obj).expr.match(TConst(TSuper));
				var objS = isSuper ? "self" : genExpr(obj);
				var argS = genArgs(args, fld.type, fld);
				if (!isSuper && isVirtual(cc, fld.name)) {
					var root = rootOf(cc, fld.name);
					var rn = className(root);
					useClass(root, e.pos);
					useClass(cc, e.pos);
					virtualUsed.set(rn + "." + fld.name, {root: root, name: fld.name});
					return '${rn}_${sanitize(fld.name)}_v(($rn*)$objS${argS.length > 0 ? ", " + argS.join(", ") : ""})';
				}
				var impl = findImpl(cc, fld.name);
				if (impl == null) return err('method ${cc.name}.${fld.name} has no body', e.pos);
				var name = useFunction(impl.c, impl.f, false, e.pos);
				return '$name((${className(impl.c)}*)$objS${argS.length > 0 ? ", " + argS.join(", ") : ""})';
			case TField(_, FEnum(_, _)):
				return err("enum constructors with arguments are not supported", e.pos);
			case TConst(TSuper):
				// super(...) inside a constructor: run the parent's constructor body on this object
				var sup = curClass == null ? null : superOf(curClass);
				var owner = sup == null ? null : ctorOwner(sup);
				if (owner == null) return "((void)0)";
				var init = useInit(owner, e.pos);
				var argS = genArgs(args, owner.constructor.get().type, owner.constructor.get());
				return '$init((${className(owner)}*)self${argS.length > 0 ? ", " + argS.join(", ") : ""})';
			case _:
				switch Context.follow(f.t) {
					case TFun(_, _):
						return '(${genExpr(f)})(${genArgs(args, f.t).join(", ")})';
					case _:
				}
				return err("only direct calls of static functions, methods and function values are supported", e.pos);
		}
	}

	function poolClass(e:TypedExpr):String {
		return switch Context.follow(e.t) {
			case TInst(c, _): useClass(c.get(), e.pos); className(c.get());
			case _: err("Pool functions need a class instance", e.pos);
		}
	}

	function genTrace(v:TypedExpr):String {
		if (isString(v.t)) return 'h64_trace_str(${genExpr(v)})';
		if (isFloat(v.t)) return 'h64_trace_fix(${genExpr(v)})';
		switch Context.follow(v.t) {
			case TAbstract(_.get() => {name: "Bool", pack: []}, _): return 'h64_trace_bool(${genExpr(v)})';
			case _:
		}
		return 'h64_trace_int(${genExpr(v)})';
	}
}

#end
